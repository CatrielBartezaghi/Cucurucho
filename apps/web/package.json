{
  "name": "heladeria-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "contract:generate": "openapi-typescript src/lib/openapi.json -o src/lib/openapi.generated.ts",
    "contract:check": "npm run contract:generate && git diff --exit-code -- src/lib/openapi.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
