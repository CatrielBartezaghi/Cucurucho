# Backend application traffic (pooled Neon URL in production)
DATABASE_URL=postgresql+psycopg://heladeria:heladeria@localhost:5433/heladeria
# Alembic only (direct Neon URL in production)
DIRECT_DATABASE_URL=postgresql+psycopg://heladeria:heladeria@localhost:5433/heladeria
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# New Vercel Blob connections use OIDC and inject the store id.
BLOB_STORE_ID=
# Optional legacy/local fallback for environments without Vercel OIDC.
BLOB_READ_WRITE_TOKEN=

# Frontend server-side proxy target
API_ORIGIN=http://localhost:8000
